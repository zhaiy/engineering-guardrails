+import unittest
+from unittest.mock import Mock, call
+
+from delivery import DeliveryUncertain, TemporaryRejection, deliver
+
+
+class DeliveryTests(unittest.TestCase):
+    def test_success_returns_result_and_preserves_arguments(self):
+        client = Mock()
+        result, payload = object(), {"order": "123"}
+        client.send.return_value = result
+        self.assertIs(deliver(client, "key", payload), result)
+        client.send.assert_called_once_with("key", payload)
+
+    def test_temporary_rejections_still_retry(self):
+        client = Mock()
+        client.send.side_effect = [TemporaryRejection(), TemporaryRejection(), "accepted"]
+        self.assertEqual(deliver(client, "key", "payload"), "accepted")
+        self.assertEqual(client.send.call_args_list, [call("key", "payload")] * 3)
+
+    def test_third_rejection_propagates(self):
+        client = Mock()
+        last = TemporaryRejection("still rejected")
+        client.send.side_effect = [TemporaryRejection(), TemporaryRejection(), last]
+        with self.assertRaises(TemporaryRejection) as caught:
+            deliver(client, "key", "payload")
+        self.assertIs(caught.exception, last)
+        self.assertEqual(client.send.call_count, 3)
+
+    def test_timeout_on_any_attempt_stops_sends_and_preserves_cause(self):
+        for attempt in range(1, 4):
+            with self.subTest(attempt=attempt):
+                client = Mock()
+                timeout = TimeoutError("response lost")
+                client.send.side_effect = [TemporaryRejection()] * (attempt - 1) + [timeout, "accepted"]
+                with self.assertRaises(DeliveryUncertain) as caught:
+                    deliver(client, "key", "payload")
+                self.assertIs(caught.exception.__cause__, timeout)
+                self.assertEqual(client.send.call_count, attempt)
+
+    def test_unrelated_failure_does_not_retry(self):
+        client = Mock()
+        failure = ValueError("bad payload")
+        client.send.side_effect = failure
+        with self.assertRaises(ValueError) as caught:
+            deliver(client, "key", "payload")
+        self.assertIs(caught.exception, failure)
+        self.assertEqual(client.send.call_count, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
