+import java.math.BigDecimal;
+import shop.ShippingFee;
+
+public class ShippingFeeTest {
+    private static void checkFee(int units, String expected) {
+        if (!new BigDecimal(expected).equals(ShippingFee.fee(units))) {
+            throw new AssertionError("Unexpected fee for " + units);
+        }
+    }
+    public static void main(String[] args) {
+        checkFee(0, "5.00");
+        checkFee(1, "5.00");
+        checkFee(11, "5.00");
+        checkFee(12, "0.00");
+        checkFee(13, "0.00");
+        checkFee(Integer.MAX_VALUE, "0.00");
+        try {
+            ShippingFee.fee(-1);
+            throw new AssertionError("Negative quantity accepted");
+        } catch (IllegalArgumentException expected) {
+            if (!"units must be nonnegative".equals(expected.getMessage())) {
+                throw new AssertionError("Changed validation message");
+            }
+        }
+        System.out.println("ShippingFeeTest passed");
+    }
+}
