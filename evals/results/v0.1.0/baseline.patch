+import java.math.BigDecimal;
+import shop.InvoiceAmounts;
+
+public class InvoiceAmountsTest {
+    private static void check(boolean condition) {
+        if (!condition) throw new AssertionError();
+    }
+    public static void main(String[] args) {
+        BigDecimal amount = new BigDecimal("10.00");
+        check(InvoiceAmounts.matches(new BigDecimal("10.0"), amount));
+        check(InvoiceAmounts.matches(new BigDecimal("1E+1"), amount));
+        check(InvoiceAmounts.matches(new BigDecimal("-10.0"), new BigDecimal("-10.00")));
+        check(InvoiceAmounts.matches(BigDecimal.ZERO, new BigDecimal("0.000")));
+        check(!InvoiceAmounts.matches(new BigDecimal("10.000000000000000001"), amount));
+        check(!InvoiceAmounts.matches(null, amount));
+        check(!InvoiceAmounts.matches(amount, null));
+        check(!InvoiceAmounts.matches(null, null));
+        check("10.00".equals(InvoiceAmounts.display(amount)));
+        check("--".equals(InvoiceAmounts.display(null)));
+        check(amount.scale() == 2);
+        System.out.println("InvoiceAmountsTest passed");
+    }
+}
