+import unittest
+
+from report import summarize
+
+
+class ReportTests(unittest.TestCase):
+    def test_empty_input_contains_all_counters(self):
+        self.assertEqual(summarize(iter(())), {"total": 0, "paid": 0, "open": 0, "cancelled": 0})
+
+    def test_no_cancelled_orders_still_has_cancelled_field(self):
+        self.assertEqual(summarize([{"status": "paid"}, {"status": "open"}]),
+                         {"total": 2, "paid": 1, "open": 1, "cancelled": 0})
+
+    def test_stream_counts_cancelled_and_preserves_other_counters(self):
+        rows = ({"status": status} for status in ["cancelled", "paid", "cancelled", "open", "unknown", None])
+        self.assertEqual(summarize(rows), {"total": 6, "paid": 1, "open": 1, "cancelled": 2})
+
+    def test_missing_status_is_counted_only_in_total(self):
+        self.assertEqual(summarize([{}]), {"total": 1, "paid": 0, "open": 0, "cancelled": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
