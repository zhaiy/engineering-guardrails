+import shop.ProductService;
+
+public class ProductServiceTest {
+    public static void main(String[] args) {
+        final String sku = "sku-123";
+        final int[] calls = {0};
+        ProductService found = new ProductService(key -> {
+            if (!sku.equals(key)) throw new AssertionError("Changed lookup key");
+            calls[0]++;
+            return "product";
+        });
+        if (!"product".equals(found.find(sku).get()) || calls[0] != 1) {
+            throw new AssertionError("Changed successful lookup");
+        }
+        if (new ProductService(key -> null).find(sku).isPresent()) {
+            throw new AssertionError("Missing product was not empty");
+        }
+        RuntimeException outage = new IllegalStateException("store unavailable");
+        ProductService failed = new ProductService(key -> { throw outage; });
+        try {
+            failed.find(sku);
+            throw new AssertionError("Failure hidden as missing product");
+        } catch (RuntimeException actual) {
+            if (actual != outage) throw new AssertionError("Original failure lost");
+        }
+        System.out.println("ProductServiceTest passed");
+    }
+}
