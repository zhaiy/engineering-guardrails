+package shop;
+
+public final class OrderMapperTest {
+    public static void main(String[] args) {
+        check("{\"id\":\"order-1\",\"note\":null}", new OrderMapper.Order("order-1", null));
+        check("{\"id\":null,\"note\":null}", new OrderMapper.Order(null, null));
+        check("{\"id\":\"order-1\",\"note\":\"\"}", new OrderMapper.Order("order-1", ""));
+        check("{\"id\":\"order-1\",\"note\":\"\"}", new OrderMapper.Order("order-1", " \t\r\n "));
+        check("{\"id\":\"order-1\",\"note\":\"hello\"}", new OrderMapper.Order("order-1", "  hello  "));
+        check("{\"id\":\"a\\\"b\",\"note\":\"a\\\"b\\\\c\\nd\\re\\tf\\u0001g\"}",
+                new OrderMapper.Order("a\"b", " a\"b\\c\nd\re\tf\u0001g "));
+        try {
+            OrderMapper.toJson(null);
+            throw new AssertionError("null order remains invalid");
+        } catch (NullPointerException expected) {
+            // The change concerns nullable notes, not nullable orders.
+        }
+        System.out.println("OrderMapperTest passed");
+    }
+
+    private static void check(String expected, OrderMapper.Order order) {
+        String actual = OrderMapper.toJson(order);
+        if (!expected.equals(actual)) throw new AssertionError("expected " + expected + ", got " + actual);
+    }
