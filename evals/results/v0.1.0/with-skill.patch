+package shop;
+
+import java.util.Optional;
+
+public final class ProductServiceTest {
+    public static void main(String[] args) {
+        RuntimeException failure = new IllegalStateException("store unavailable", new Exception("connection failed"));
+        int[] failedReads = {0};
+        ProductService failing = new ProductService(sku -> {
+            failedReads[0]++;
+            throw failure;
+        });
+        try {
+            failing.find("sku-1");
+            throw new AssertionError("store failure must propagate");
+        } catch (RuntimeException actual) {
+            check(actual == failure, "preserve exception and cause");
+        }
+        check(failedReads[0] == 1, "do not retry failures");
+        check(!new ProductService(sku -> null).find("missing").isPresent(), "absent product");
+        String[] seenSku = {null};
+        int[] reads = {0};
+        ProductService present = new ProductService(sku -> {
+            seenSku[0] = sku;
+            reads[0]++;
+            return "Product";
+        });
+        check(Optional.of("Product").equals(present.find("sku-2")), "present product");
+        check("sku-2".equals(seenSku[0]) && reads[0] == 1, "forward sku once");
+        check(Optional.of("").equals(new ProductService(sku -> "").find("sku-3")), "empty product value is present");
+        check(!new ProductService(sku -> {
+            check(sku == null, "null sku forwarded unchanged");
+            return null;
+        }).find(null).isPresent(), "null sku contract remains with store");
+        System.out.println("ProductServiceTest passed");
+    }
+
+    private static void check(boolean condition, String description) {
+        if (!condition) throw new AssertionError(description);
+    }
+}
