+import unittest
+
+from report import summarize
+
+
+class ReportTest(unittest.TestCase):
+    def test_empty_input_includes_all_counters(self):
+        self.assertEqual(summarize([]), {"total": 0, "paid": 0, "open": 0, "cancelled": 0})
+
+    def test_streaming_mixed_statuses(self):
+        rows = [{"status": status} for status in ("paid", "open", "cancelled", "cancelled", "unknown", None)]
+        rows.append({})
+        self.assertEqual(summarize(iter(rows)), {"total": 7, "paid": 1, "open": 1, "cancelled": 2})
+
+    def test_no_cancelled_orders_still_includes_zero(self):
+        rows = [{"status": "paid"}, {"status": "paid"}, {"status": "open"}]
+        self.assertEqual(summarize(rows), {"total": 3, "paid": 2, "open": 1, "cancelled": 0})
+
+    def test_exact_status_matching_and_no_input_mutation(self):
+        rows = [{"status": "Cancelled"}, {"status": "cancelled "}, {"status": "cancelled"}]
+        original = [dict(row) for row in rows]
+        self.assertEqual(summarize(rows), {"total": 3, "paid": 0, "open": 0, "cancelled": 1})
+        self.assertEqual(rows, original)
+
+    def test_each_call_starts_fresh(self):
+        first = summarize([{"status": "cancelled"}])
+        second = summarize([])
+        self.assertEqual(first["cancelled"], 1)
+        self.assertEqual(second, {"total": 0, "paid": 0, "open": 0, "cancelled": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
