+package shop;
+
+import java.math.BigDecimal;
+
+public final class InvoiceAmountsTest {
+    public static void main(String[] args) {
+        check(InvoiceAmounts.matches(new BigDecimal("10.0"), new BigDecimal("10.00")), "scale-independent equality");
+        check(InvoiceAmounts.matches(new BigDecimal("0.00"), BigDecimal.ZERO), "zero equality");
+        check(InvoiceAmounts.matches(new BigDecimal("-10.00"), new BigDecimal("-10.0")), "negative equality");
+        check(InvoiceAmounts.matches(new BigDecimal("1E+2"), new BigDecimal("100.00")), "negative scale equality");
+        check(!InvoiceAmounts.matches(new BigDecimal("10.00"), new BigDecimal("10.01")), "different amounts");
+        check(!InvoiceAmounts.matches(new BigDecimal("1000000000000000000.01"), new BigDecimal("1000000000000000000.02")), "no loss of precision");
+        check(!InvoiceAmounts.matches(null, null), "two missing amounts");
+        check(!InvoiceAmounts.matches(null, BigDecimal.ZERO), "missing expected amount");
+        check(!InvoiceAmounts.matches(BigDecimal.ZERO, null), "missing actual amount");
+        check("10.00".equals(InvoiceAmounts.display(new BigDecimal("10.00"))), "display preserves scale");
+        check("100".equals(InvoiceAmounts.display(new BigDecimal("1E+2"))), "plain display");
+        check("--".equals(InvoiceAmounts.display(null)), "missing display");
+        System.out.println("InvoiceAmountsTest passed");
+    }
+
+    private static void check(boolean condition, String description) {
+        if (!condition) throw new AssertionError(description);
