+import unittest
+
+from delivery import DeliveryUncertain, TemporaryRejection, deliver
+
+
+class Client:
+    def __init__(self, outcomes):
+        self.outcomes = iter(outcomes)
+        self.calls = []
+
+    def send(self, key, payload):
+        self.calls.append((key, payload))
+        outcome = next(self.outcomes)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return outcome
+
+
+class DeliveryTest(unittest.TestCase):
+    def test_timeout_stops_immediately_and_keeps_cause(self):
+        timeout = TimeoutError("receiver outcome unknown")
+        client = Client([timeout, "must not be sent"])
+        with self.assertRaises(DeliveryUncertain) as caught:
+            deliver(client, "request-1", {"value": 1})
+        self.assertIs(caught.exception.__cause__, timeout)
+        self.assertEqual(len(client.calls), 1)
+
+    def test_timeout_after_rejections_stops_at_that_attempt(self):
+        for rejection_count in (1, 2):
+            with self.subTest(rejection_count=rejection_count):
+                timeout = TimeoutError("unknown")
+                client = Client([TemporaryRejection()] * rejection_count + [timeout, "must not be sent"])
+                with self.assertRaises(DeliveryUncertain) as caught:
+                    deliver(client, "key", None)
+                self.assertIs(caught.exception.__cause__, timeout)
+                self.assertEqual(len(client.calls), rejection_count + 1)
+
+    def test_success_after_rejections_preserves_result_and_arguments(self):
+        result = object()
+        payload = {"value": 2}
+        client = Client([TemporaryRejection(), TemporaryRejection(), result])
+        self.assertIs(deliver(client, "key", payload), result)
+        self.assertEqual(client.calls, [("key", payload)] * 3)
+        self.assertTrue(all(call[1] is payload for call in client.calls))
+
+    def test_rejections_stop_after_three_attempts(self):
+        final = TemporaryRejection("try later")
+        client = Client([TemporaryRejection(), TemporaryRejection(), final, "must not be sent"])
+        with self.assertRaises(TemporaryRejection) as caught:
+            deliver(client, "key", {})
+        self.assertIs(caught.exception, final)
+        self.assertEqual(len(client.calls), 3)
+
+    def test_other_failures_propagate_without_retry(self):
+        failure = ValueError("invalid request")
+        client = Client([failure, "must not be sent"])
+        with self.assertRaises(ValueError) as caught:
+            deliver(client, "key", {})
+        self.assertIs(caught.exception, failure)
+        self.assertEqual(len(client.calls), 1)
+
+    def test_immediate_success_including_none(self):
+        for result in (None, False, {"accepted": True}):
+            with self.subTest(result=result):
+                client = Client([result])
+                self.assertIs(deliver(client, "key", {}), result)
+                self.assertEqual(len(client.calls), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
